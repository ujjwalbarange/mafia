# ============================================================
# Mafia Party Game — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
# For local dev: http://localhost:5173
# For production: your Vercel app URL (e.g. https://mafia-game.vercel.app)
# Also auto-allows any *.vercel.app domain
CLIENT_URL=http://localhost:5173

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=mafia_game

# Session Secret (change in production)
SESSION_SECRET=change_this_secret_in_production

# Game Settings
ROOM_CODE_LENGTH=6
PIN_LENGTH=4
MAX_PLAYERS_PER_ROOM=15
RECONNECT_TIMEOUT_MS=30000
